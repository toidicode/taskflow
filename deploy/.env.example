# Trên server: cp .env.example .env && chmod 600 .env. KHÔNG commit .env.
TASKFLOW_VERSION=0.39.0
TASKFLOW_DOMAIN=api.example.com

# openssl rand -hex 24 (chỉ gồm 0-9a-f, đặt thẳng vào URL được)
POSTGRES_PASSWORD=
# openssl rand -base64 32
TASKFLOW_JWT_SECRET=

# cấu hình khác của API (Bài 28)
TASKFLOW_LOG_FORMAT=json
TASKFLOW_CORS_ORIGIN=https://app.example.com
TZ=Asia/Ho_Chi_Minh
